# infra/.env — read by `docker compose -f infra/docker-compose.yml`.
# Copy to infra/.env and replace every "change-me". Generate secrets with:
#   openssl rand -hex 24

# MinIO admin (web console, `mc admin`). Never given to the OTA server or CI.
MINIO_ROOT_USER=apex-admin
MINIO_ROOT_PASSWORD=change-me

# Bucket and least-privilege user created by the minio-init container.
# apps/ota-server/.env and the mobile app's .env.hotupdater use the same values.
S3_BUCKET=hot-updater
S3_ACCESS_KEY_ID=apex-ota
S3_SECRET_ACCESS_KEY=change-me

# Host ports. The S3 API must be reachable from phones on the booth Wi-Fi;
# the console stays on the laptop unless MINIO_CONSOLE_BIND is 0.0.0.0.
MINIO_API_BIND=0.0.0.0
MINIO_API_PORT=9000
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001

# Optional image overrides (defaults are pinned in docker-compose.yml).
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
# MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z
