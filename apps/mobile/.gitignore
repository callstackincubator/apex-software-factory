# node_modules/, dist/, .expo/ and .env files are ignored at the repo root.

# Generated by `expo start` / `expo export`
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo

# Continuous Native Generation: `expo prebuild` writes these
/ios
/android
.kotlin/
*.orig.*

# Signing material
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# hot-updater deploy output (bundles, build artefacts). The exact line keeps
# `hot-updater deploy` from appending it here on every machine.
.hot-updater/output
