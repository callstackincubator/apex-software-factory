{
  "expo": {
    "name": "Apex Factory",
    "slug": "apex-factory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apexfactory",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0C",
    "ios": {
      "bundleIdentifier": "com.callstack.apexfactory",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Apex Factory downloads new features from the Callstack booth laptop on this Wi-Fi network."
      }
    },
    "android": {
      "package": "com.callstack.apexfactory",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "@hot-updater/react-native",
        {
          "channel": "production"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "@appduct/react-native",
        {
          "trust": "link",
          "allowPrivateLanOnly": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
