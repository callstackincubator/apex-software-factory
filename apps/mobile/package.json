{
  "name": "@apex/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:agent": "WITH_ROZENITE=true APPDUCT_ENABLED=1 expo start --dev-client",
    "ios": "APPDUCT_ENABLED=1 expo run:ios",
    "android": "APPDUCT_ENABLED=1 expo run:android",
    "prebuild": "APPDUCT_ENABLED=1 expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:check": "APPDUCT_ENABLED=1 expo export --platform ios --platform android --output-dir dist",
    "ota:deploy": "APPDUCT_ENABLED=1 node scripts/hot-updater.mjs deploy",
    "ota:fingerprint": "APPDUCT_ENABLED=1 node scripts/hot-updater.mjs fingerprint"
  },
  "dependencies": {
    "@apex/contract": "workspace:*",
    "@apex/event-bus": "workspace:*",
    "@appduct/react-native": "0.14.0",
    "@expo/ui": "~57.0.21",
    "@hot-updater/react-native": "0.36.17",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.26",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-calendar": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-maps": "1.27.2",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-barcode-scanner": "5.2.3",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@expo/fingerprint": "~0.20.13",
    "@hot-updater/aws": "0.36.17",
    "@hot-updater/expo": "0.36.17",
    "@hot-updater/standalone": "0.36.17",
    "@rozenite/agent-bridge": "2.4.0",
    "@rozenite/controls-plugin": "2.4.0",
    "@rozenite/expo-atlas-plugin": "2.4.0",
    "@rozenite/metro": "2.4.0",
    "@rozenite/network-activity-plugin": "2.4.0",
    "@rozenite/require-profiler-plugin": "2.4.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "hot-updater": "0.36.17",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "rozenite": "2.4.0",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "forceExit": true,
    "preset": "jest-expo",
    "resolver": "<rootDir>/jest.resolver.js",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|standard-navigation))"
    ]
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-vision-camera-barcode-scanner"
        ]
      }
    }
  }
}
