# The footer shows the API round trip, and shows it again after tapping the API
# row. Needs the product API running (the completion condition's setup): the
# first check then lands "ok" with a time, and a tap re-checks without losing it.
#
#   pnpm exec agent-device replay apps/mobile/e2e/api-latency.ad --udid <UDID>
context platform=ios timeout=120000
env APP_ID=com.callstack.apexfactory
open ${APP_ID} --relaunch
wait id="home-headline" 60000
scroll bottom
wait id="status-api-latency" 15000
is exists "id=\"status-api-latency\""
is exists "id=\"status-api\""
# Tapping the row checks again; the round trip is shown again afterwards.
press id="status-api"
wait stable 500 10000
wait id="status-api-latency" 15000
is exists "id=\"status-api-latency\""
close
