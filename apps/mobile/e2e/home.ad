# The home screen an agent starts from: the headline, a non-empty "Shipped at the
# booth" list, and the status footer (API answered or offline, app version, running
# bundle). Passes on a debug (Metro) or release build, API up or down. The count
# badge is never checked against a number, because every shipped feature adds one;
# the bundle line is only checked for presence, because a lane binary reports channel
# "lane" and a production binary "production" (ADR 0027).
#
#   .agents/scripts/device-lane.sh ad replay apps/mobile/e2e/home.ad
context platform=ios timeout=120000
env APP_ID=com.callstack.apexfactory
open ${APP_ID} --relaunch
wait id="home-headline" 60000
is exists id="shipped-count"
is absent id="shipped-empty"
scroll bottom
is visible id="status-api"
wait absent "label=\"API status: checking…\"" 10000
is visible id="status-app"
is visible id="status-bundle"
close
