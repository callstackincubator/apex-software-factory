{
  "cli": {
    "version": ">= 27.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "22.23.3",
      "pnpm": "11.22.0",
      "env": {
        "APPDUCT_ENABLED": "1"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "environment": "production"
    },
    "lane": {
      "extends": "base",
      "channel": "lane",
      "environment": "preview"
    }
  }
}
