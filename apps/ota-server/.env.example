# apps/ota-server/.env — loaded by `start`, `dev` and `db:*` when present.
# Real environment variables win over this file. See docs/internal/OTA.md.

# Where the server listens. 0.0.0.0 so phones on the booth Wi-Fi can reach it.
HOST=0.0.0.0
PORT=3002
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Bearer token for /hot-updater/api/* (used by `hot-updater deploy` / console).
# At least 32 characters. Generate with:  openssl rand -hex 32
# The CI runner and the mobile app's .env.hotupdater need the same value.
HOT_UPDATER_AUTH_TOKEN=change-me-to-the-output-of-openssl-rand-hex-32

# SQLite file with bundle metadata. Default: apps/ota-server/data/ota.sqlite
# DATABASE_PATH=./data/ota.sqlite

# Where this server reaches MinIO (server-side reads).
S3_ENDPOINT=http://127.0.0.1:9000
# Origin signed into the download URLs devices receive.
#   auto (default): reuse the host the device used to reach this server, with
#     S3_ENDPOINT's scheme and port. A phone calling http://192.168.1.20:3002
#     downloads from http://192.168.1.20:9000; a simulator calling localhost
#     downloads from localhost.
#   http://<laptop-lan-ip>:9000: pin it, e.g. if devices reach this server
#     through a proxy or a different host than MinIO.
S3_PUBLIC_ENDPOINT=auto
S3_REGION=us-east-1
# Same bucket and user as infra/.env (created by the minio-init container).
S3_BUCKET=hot-updater
S3_ACCESS_KEY_ID=apex-ota
S3_SECRET_ACCESS_KEY=change-me
