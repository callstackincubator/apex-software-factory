{
  "$schema": "https://opencode.ai/config.json",
  "model": "callstack.ai/callstack/Apex",
  "small_model": "callstack.ai/callstack/Apex",
  "default_agent": "build",
  "share": "disabled",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "pnpm *": "allow",
      "node *": "allow",
      "jq *": "allow",
      "cd *": "allow",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "echo *": "allow",
      "test *": "allow",
      "sleep *": "allow",
      "mktemp*": "allow",
      "command -v *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git fetch*": "allow",
      "git switch *": "allow",
      "git checkout *": "allow",
      "git restore *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git merge-base *": "allow",
      "git rev-parse *": "allow",
      "git ls-files*": "allow",
      "git ls-tree *": "allow",
      "git worktree *": "allow",
      "git push origin *": "allow",
      "git push -u origin *": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "gh issue create *": "allow",
      "gh issue comment *": "allow",
      "gh issue edit *": "allow",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh pr diff *": "allow",
      "gh pr checks *": "allow",
      "gh pr create *": "allow",
      "gh pr edit *": "allow",
      "gh pr comment *": "allow",
      "gh pr ready *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh label list*": "allow",
      "gh repo view *": "allow",
      "gh api graphql *": "allow",
      "xcrun simctl list*": "allow",
      ".agents/scripts/ensure-pnpm.sh*": "allow",
      ".agents/scripts/worktree.sh *": "allow",
      ".agents/scripts/native-check.sh*": "allow",
      ".agents/scripts/review-inputs.sh *": "allow",
      ".agents/scripts/sim-lane.sh *": "allow",
      ".agents/scripts/merge-pr.sh *": "allow",
      "git commit --no-verify*": "deny",
      "git commit -n*": "deny",
      "git commit * --no-verify*": "deny",
      "git commit * -n": "deny",
      "git commit * -n *": "deny",
      "git push --no-verify*": "deny",
      "git push * --no-verify*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git push * +*": "deny",
      "git push * main": "deny",
      "git push * main *": "deny",
      "git push * *:main*": "deny",
      "git push * --delete*": "deny",
      "git push * -d *": "deny",
      "git reset --hard*": "deny",
      "git branch -D *": "deny",
      "git config *": "deny",
      "LEFTHOOK=0 *": "deny",
      "LEFTHOOK=false *": "deny",
      "lefthook uninstall*": "deny",
      "gh pr merge*": "deny",
      "gh release *": "deny",
      "gh repo delete *": "deny",
      "gh repo edit *": "deny",
      "gh issue delete *": "deny",
      "gh issue transfer *": "deny",
      "gh secret *": "deny",
      "gh variable *": "deny",
      "gh workflow *": "deny",
      "gh api * -X DELETE*": "deny",
      "gh api * --method DELETE*": "deny",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "pnpm * publish*": "deny",
      "pnpm release*": "deny",
      "pnpm run release*": "deny",
      "pnpm dlx *": "deny",
      "npx *": "deny",
      "bunx *": "deny",
      "*hot-updater deploy*": "deny",
      "*hot-updater rollback*": "deny",
      "eas *": "deny",
      "docker *": "deny",
      "docker-compose *": "deny",
      "sudo *": "deny"
    }
  }
}
