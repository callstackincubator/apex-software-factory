{
  "$schema": "https://opencode.ai/config.json",
  "model": "callstack.ai/callstack/Apex",
  "small_model": "callstack.ai/callstack/Apex",
  "providers": {
    "callstack.ai": {
      "name": "callstack.ai",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.callstack.ai/v1"
      },
      "models": {
        "callstack/Apex": {
          "name": "Apex",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "input": 240000,
            "output": 16384
          },
          "settings": {
            "reasoningEffort": "medium"
          },
          "variants": [
            {
              "id": "none",
              "settings": {
                "reasoningEffort": "none"
              }
            },
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh"
              }
            }
          ],
          "compatibility": {
            "reasoningField": "reasoning"
          }
        }
      }
    }
  },
  "default_agent": "build",
  "share": "disabled",
  "mcp": {
    "agent-device": {
      "type": "local",
      "command": ["pnpm", "exec", "agent-device", "mcp"],
      "enabled": true,
      "environment": {
        "AGENT_DEVICE_NO_UPDATE_NOTIFIER": "1"
      },
      "timeout": 120000
    },
    "appduct": {
      "type": "local",
      "command": ["pnpm", "exec", "appduct", "mcp", "--scheme", "apexfactory"],
      "cwd": "apps/mobile",
      "enabled": true,
      "timeout": 60000
    },
    "simlock": {
      "type": "local",
      "command": ["pnpm", "exec", "simlock", "mcp"],
      "enabled": false,
      "environment": {
        "SIMLOCK_AGENT_ID": "opencode-build"
      },
      "timeout": 600000
    }
  },
  "permission": {
    "*": "allow",
    "external_directory": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "deny",
    "execute": "deny",
    "agent-device_*": "deny",
    "appduct_*": "deny",
    "simlock_*": "deny",
    "skill": {
      "*": "allow",
      "callstack-react-native-best-practices": "deny",
      "expo-animation": "deny",
      "expo-data-fetching": "deny",
      "expo-design-system": "deny",
      "expo-native-ui": "deny",
      "expo-router": "deny",
      "expo-ui": "deny",
      "react-native-mmkv": "deny",
      "react-native-vision-camera": "deny",
      "swm-react-native-best-practices": "deny",
      "vercel-composition-patterns": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "* .env": "deny",
      "* .env *": "deny",
      "* .env.*": "deny",
      "*/.env": "deny",
      "*/.env *": "deny",
      "*/.env.*": "deny",
      "*gh pr merge*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git push * +*": "deny",
      "git push * main": "deny",
      "git push * main *": "deny",
      "git push * *:main": "deny",
      "git push * *:main *": "deny",
      "git push * HEAD:main*": "deny",
      "git push * *:refs/heads/main*": "deny",
      "*--no-verify*": "deny",
      "git commit -n*": "deny",
      "git commit * -n": "deny",
      "git commit * -n *": "deny",
      "LEFTHOOK=0 *": "deny",
      "LEFTHOOK=false *": "deny",
      "*lefthook uninstall*": "deny",
      "*hot-updater deploy*": "deny",
      "*hot-updater rollback*": "deny",
      "*ota:deploy*": "deny",
      "*simlock nuke*": "deny",
      "*simlock release --all*": "deny",
      "*simlock config set*": "deny",
      "*simlock daemon stop*": "deny",
      "*simlock cleanup*": "deny",
      "*simlock token*": "deny",
      "*simlock component*": "deny",
      "*--allow-download*": "deny",
      "*agent-device install-from-source*": "deny",
      "*agent-device react-devtools*": "deny",
      "*agent-device daemon stop*": "deny",
      "*appduct daemon stop*": "deny",
      "*appduct sessions revoke*": "deny",
      "*xcrun simctl erase*": "deny",
      "*xcrun simctl delete*": "deny",
      "*xcrun simctl shutdown*": "deny",
      "*adb kill-server*": "deny",
      "*emu kill*": "deny"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "agent-device_*": "allow",
        "appduct_*": "allow",
        "simlock_*": "allow",
        "skill": "allow"
      }
    }
  }
}
